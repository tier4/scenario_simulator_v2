+
+void DiffusionPlanner::on_plan_trajectory_service(
+  const std::shared_ptr<diffusion_planner_lockstep_msgs::srv::PlanTrajectory::Request> request,
+  std::shared_ptr<diffusion_planner_lockstep_msgs::srv::PlanTrajectory::Response> response)
+{
+  // All per-frame inputs come from the request; route and map are still
+  // received once via topics (mission_planner / map_loader). The route comes
+  // exclusively from the callback subscription (single source of truth).
+  const rclcpp::Time frame_time(request->frame_time, RCL_ROS_TIME);
+
+  // Aliasing shared_ptrs avoid deep-copying the (NPC-count proportional)
+  // request fields on every planning cycle; `request` stays alive through them.
+  std::vector<std::shared_ptr<const autoware_perception_msgs::msg::TrafficLightGroupArray>>
+    traffic_signals;
+  if (request->has_traffic_signals) {
+    traffic_signals.emplace_back(request, &request->traffic_signals);
+  }
+
+  const auto output = run_planning_cycle(
+    std::shared_ptr<const TrackedObjects>(request, &request->tracked_objects),
+    std::shared_ptr<const Odometry>(request, &request->ego_kinematic_state),
+    std::shared_ptr<const AccelWithCovarianceStamped>(request, &request->ego_acceleration),
+    traffic_signals,
+    std::shared_ptr<const TurnIndicatorsReport>(request, &request->turn_indicators),
+    lockstep_route_, frame_time);
+
+  if (output) {
+    response->success = true;
+    response->trajectory = output->trajectory;
+    response->turn_indicators_command = output->turn_indicator_command;
+  } else {
+    response->success = false;
+    response->message =
+      "planning cycle failed (model/map/route not ready, missing input, or inference error)";
+  }
+}
